# Data (fetched/generated, not committed -- see data/manifest.json for provenance)
data/raw/
data/processed/
# Regeneratable benchmark reports (re-run src/eval/validate_baseline.py to reproduce).
# Note: data/splits/ is intentionally NOT gitignored -- those are the saved,
# seeded clade-exclusion splits and are meant to be committed for reproducibility.
data/eval_results/
# BLAST database + FASTA files, rebuilt per benchmark run from the current
# split's train/test sequences (src/baselines/blast_baseline.py).
data/blast_db/

