# Lightweight, dashboard-only image (Step 7 of the build plan).
#
# There's no separately-trained model artifact to pull from external
# storage here -- the k-mer+PCA encoder and centroid-based classifier are
# cheap enough (CPU, seconds) to fit at container start directly from
# data/processed/sequences.parquet, cached in-process by Streamlit's
# st.cache_resource. That parquet file is gitignored (regenerated by the
# ingest/clean pipeline, not committed), so it must be present in a
# mounted volume or baked into a derived image at deploy time; without it,
# the dashboard still starts and shows a "run ingestion first" message
# instead of crashing (see app/dashboard.py).
#
# Same Python version as the main Dockerfile, for the same reason (pinned
# numpy/scipy/scikit-learn wheels require 3.12+).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PROJECT_ROOT=/app

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app/ app/
COPY src/ src/
COPY configs/ configs/
COPY .streamlit/ .streamlit/

EXPOSE 8501

CMD ["streamlit", "run", "app/dashboard.py", "--server.address=0.0.0.0", "--server.port=8501"]
